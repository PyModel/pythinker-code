{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.codex/hooks/check-changeset.sh'",
            "timeout": 15,
            "statusMessage": "Checking changeset gate..."
          },
          {
            "type": "command",
            "command": "bash '.codex/hooks/coderabbit-merge-gate.sh'",
            "timeout": 30,
            "statusMessage": "Checking CodeRabbit review status..."
          }
        ]
      }
    ]
  }
}
