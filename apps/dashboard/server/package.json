{
  "name": "@pythoughts/dashboard-server",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./start": {
      "types": "./src/start.ts",
      "default": "./src/start.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@pythoughts/agent-core": "workspace:^",
    "@pythoughts/kosong": "workspace:^",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "vitest": "4.1.9"
  }
}
