:80 {
	root * /srv

	# Keep HTML as the default and exclude explicit Markdown q=0 requests.
	@markdown {
		path /
		header_regexp Accept (?i)(?:^|,)\s*text/markdown\s*(?:;\s*q=(?:0\.[0-9]*[1-9][0-9]*|1(?:\.0*)?))?\s*(?:,|$)
	}

	header Content-Signal "ai-train=no, search=yes, ai-input=yes"
	header / {
		Link "<https://pythoughts-labs.github.io/pythinker-code/>; rel=\"describedby\"; type=\"text/html\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
		Vary "Accept"
	}
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /robots.txt Content-Type "text/plain; charset=utf-8"
	header /sitemap.xml Content-Type "application/xml; charset=utf-8"
	rewrite @markdown /index.md

	file_server
	header /pythinker-code/* Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
