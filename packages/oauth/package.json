{
  "name": "@pymodel/pythinker-code-oauth",
  "version": "0.3.0",
  "private": true,
  "description": "Login platform layer: model listing, config provisioning, and OpenAI Codex OAuth",
  "license": "MIT",
  "author": "Pythoughts",
  "homepage": "https://github.com/PyModel/pythinker-code/tree/main/packages/oauth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyModel/pythinker-code.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/PyModel/pythinker-code/issues"
  },
  "keywords": [
    "pythinker",
    "oauth",
    "authentication",
    "auth",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./oauth-pages": {
      "types": "./src/oauth-pages.ts",
      "default": "./src/oauth-pages.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
